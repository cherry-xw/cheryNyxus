{
  "extends": "./apps/backend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "apps/backend/src/*"
      ],
      "@test/*": [
        "apps/backend/test/*"
      ],
      "@chery/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@chery/protocol/*": [
        "packages/protocol/src/*"
      ],
      "@chery/plugin-api": [
        "packages/plugin-api/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/backend/src/**/*.ts"
  ]
}
