{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "ui-built/**"] },
    "@chery/manager#build": { "dependsOn": ["^build"], "outputs": ["dist/**", "server-dist/**"] },
    "web#build": { "dependsOn": ["^build"], "outputs": ["$TURBO_ROOT$/dist/web/**"] },
    "test": {},
    "type-check": {},
    "dev": { "cache": false, "persistent": true },
    "preview": { "cache": false, "persistent": true }
  }
}
