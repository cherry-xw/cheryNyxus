{
  "name": "cherynyxus",
  "version": "1.0.0",
  "description": "sp",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "apps/backend/dist/index.js",
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs",
    "kill:ports": "node scripts/kill-ports.mjs",
    "plan": "node tools/plan-viewer/server.mjs",
    "plan:lint": "node tools/plan-viewer/lint-source.mjs",
    "docs:test": "node --test scripts/docs/tests/*.test.mjs",
    "docs:check-links": "node scripts/docs/check-links.mjs",
    "docs:check-structure": "node scripts/docs/check-structure.mjs",
    "docs:check-plan": "node scripts/docs/check-plan.mjs",
    "docs:check-metadata": "node scripts/docs/check-metadata.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "relay:dev": "tsx apps/relay/src/index.ts",
    "relay:start": "node apps/relay/dist/index.js",
    "relay:build": "vite build --config apps/relay/vite.config.ts",
    "relay:type-check": "tsc --noEmit -p apps/relay/tsconfig.json",
    "relay:test": "vitest run --config apps/relay/vitest.config.ts",
    "manager:dev": "tsx apps/manager/src/index.ts",
    "manager:cli": "node apps/manager/server-dist/index.js",
    "manager:type-check": "tsc --noEmit -p apps/manager/tsconfig.json",
    "manager:build": "vite build --config apps/manager/vite.config.ts",
    "manager:test": "vitest run --config apps/manager/vitest.config.ts",
    "prebuild": "pnpm type-check",
    "build": "vite build --config apps/backend/vite.config.ts --ssr --mode dev",
    "build:test": "vite build --config apps/backend/vite.config.ts --ssr --mode test",
    "build:prod": "vite build --config apps/backend/vite.config.ts --ssr --mode prod",
    "compile:senses": "node apps/backend/dist/index.js compile-senses",
    "ingress:cli": "tsx apps/backend/src/service/ingress/cli.ts",
    "ingress:test": "vitest run --config apps/backend/vite.config.ts apps/backend/test/service/ingress.test.ts apps/backend/test/service/ingressApi2.test.ts apps/backend/test/service/ingressRequest.test.ts --no-file-parallelism",
    "qq-ingress:build": "vite build --config plugins/qq/vite.config.ts && vite build --config plugins/qq/ui.vite.config.ts && node plugins/qq/scripts/package.mjs",
    "qq-ingress:type-check": "tsc --noEmit -p plugins/qq/tsconfig.json",
    "settings-ingress:build": "vite build --config plugins/settings/vite.config.ts && vite build --config plugins/settings/ui.vite.config.ts && node plugins/settings/scripts/package.mjs",
    "settings-ingress:type-check": "tsc --noEmit -p plugins/settings/tsconfig.json",
    "qq-ingress:test": "vitest run --config apps/backend/vite.config.ts apps/backend/test/service/qqPluginWire.test.ts apps/backend/test/service/qqProtocolContract.test.ts apps/backend/test/service/qqReviewBoundaries.test.ts apps/backend/test/agent/middleware/qqRequest.test.ts --no-file-parallelism",
    "dev": "vite build --config apps/backend/vite.config.ts --ssr --mode dev && nodemon --watch apps/backend/src --ext ts --exec \"vite build --config apps/backend/vite.config.ts --ssr --mode dev && node apps/backend/dist/index.js\"",
    "test": "pnpm test:all",
    "test:all": "npm run test:backend && npm run manager:test && npm run plugins:test && npm run relay:test && npm run test:web && npm run test:protocol",
    "test:backend": "vitest run --config apps/backend/vite.config.ts",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "test:protocol": "npm run test:protocol:backend && npm run test:protocol:web",
    "test:protocol:backend": "vitest run --config apps/backend/vitest.protocol.config.ts",
    "test:protocol:web": "vitest run --config apps/web/vitest.protocol.config.ts --no-file-parallelism",
    "test:protocol:coverage": "vitest run --config apps/backend/vitest.protocol.config.ts --coverage",
    "test:watch": "vitest --config apps/backend/vite.config.ts",
    "test:coverage": "vitest run --config apps/backend/vite.config.ts --coverage",
    "type-check": "tsc --noEmit -p apps/backend/tsconfig.json",
    "type-check:unused": "tsc --noEmit -p apps/backend/tsconfig.json --noUnusedLocals --noUnusedParameters",
    "lint": "eslint apps/backend/src/",
    "lint:fix": "eslint apps/backend/src/ --fix",
    "format": "prettier --write \"apps/backend/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/backend/src/**/*.ts\"",
    "deadcode:scan": "node scripts/deadcode-scan.mjs",
    "jscpd:dup": "jscpd --config .jscpd.json --no-tips",
    "jscpd:dup:check": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones --no-tips",
    "jscpd:baseline": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --update-baseline --no-tips",
    "jscpd:deadcode": "jscpd --config .jscpd.json --dead-code --no-tips",
    "jscpd:complexity": "jscpd --config .jscpd.json --complexity --summary-top 20 --no-tips",
    "jscpd:health": "jscpd --config .jscpd.json --dashboard --no-tips",
    "regression:code": "pnpm jscpd:dup:check && pnpm jscpd:deadcode && pnpm jscpd:complexity",
    "web:dev": "pnpm --filter web dev:web",
    "web:build": "pnpm --filter web build",
    "web:preview": "pnpm --filter web preview",
    "web:type-check": "pnpm --filter web type-check",
    "dev:all": "concurrently -n backend,web -c blue,green \"pnpm dev\" \"pnpm --filter web dev:web\"",
    "build:all": "npm run type-check:all && npm run build:prod && npm run qq-ingress:build && npm run settings-ingress:build && npm run manager:build && vite build --config apps/manager/vite.config.ts --ssr && npm run relay:build && npm --prefix apps/web run build",
    "type-check:all": "npm run type-check && npm run manager:type-check && npm run qq-ingress:type-check && npm run settings-ingress:type-check && npm run relay:type-check && npm --prefix apps/web run type-check",
    "plugins:test": "vitest run --config plugins/vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherry-xw/CheryNyxus.git"
  },
  "keywords": [
    "sp"
  ],
  "author": "chery",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cherry-xw/CheryNyxus/issues"
  },
  "homepage": "https://github.com/cherry-xw/CheryNyxus#readme",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "chery-fetch": "^1.0.13",
    "concurrently": "^10.0.3",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jscpd": "^5.3.2",
    "knip": "^6.32.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.14",
    "vite-plugin-native-modules": "^2.2.1",
    "vitest": "^4.1.7",
    "vue": "^3.5.39"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.0.1-rc.1",
    "@ff-labs/fff-node": "^0.9.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@swc/wasm": "^1.15.40",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.10.0",
    "croner": "^10.0.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1",
    "motion-v": "^2.3.0",
    "node-pty": "^1.1.0",
    "nodemon": "^3.1.14",
    "ollama": "^0.6.3",
    "openai": "^6.35.0",
    "playwright": "1.58.2",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "unbash": "4.0.10",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.1",
    "zod-to-json-schema": "^3.25.2",
    "@chery/plugin-api": "workspace:*",
    "@chery/protocol": "workspace:*"
  }
}
