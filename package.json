{
  "name": "cheryclaw",
  "version": "1.0.0",
  "description": "sp",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "test -f .env || cp .env.example .env",
    "build": "vite build --ssr && cp .env.example dist/.env",
    "build:test": "vite build --ssr --mode test && cp .env.example dist/.env",
    "build:prod": "vite build --ssr --mode prod && cp .env.example dist/.env",
    "start": "node dist/index.js",
    "dev": "vite build --ssr --watch & nodemon --watch dist/index.js dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherry-xw/cheryClaw.git"
  },
  "keywords": [
    "sp"
  ],
  "author": "chery",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cherry-xw/cheryClaw/issues"
  },
  "homepage": "https://github.com/cherry-xw/cheryClaw#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "chery-fetch": "^1.0.13",
    "eslint": "^10.2.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1",
    "nodemon": "^3.1.14",
    "ollama": "^0.6.3",
    "openai": "^6.35.0",
    "uuid": "^14.0.0",
    "vite": "^8.0.14",
    "zod": "^4.4.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
