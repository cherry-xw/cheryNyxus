{
  "name": "cheryclaw",
  "version": "1.0.0",
  "description": "sp",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "test -f .env || cp .env.example .env",
    "prebuild": "pnpm type-check",
    "build": "vite build --ssr --mode dev",
    "build:test": "vite build --ssr --mode test",
    "build:prod": "vite build --ssr --mode prod",
    "compile:senses": "node dist/index.js compile-senses",
    "dev": "vite build --ssr --mode dev && nodemon --watch src --ext ts --exec \"vite build --ssr --mode dev && node dist/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "tsx test/demo.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "type-check:unused": "tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters",
    "web:dev": "pnpm --filter web dev:web",
    "electron:dev": "pnpm --filter web dev:electron",
    "web:build": "pnpm --filter web build",
    "web:preview": "pnpm --filter web preview",
    "web:type-check": "pnpm --filter web type-check",
    "dev:all": "concurrently -n backend,web -c blue,green \"pnpm dev\" \"pnpm --filter web dev:web\"",
    "build:all": "pnpm type-check:all && pnpm build && pnpm --filter web build",
    "type-check:all": "pnpm type-check && pnpm --filter web type-check",
    "pack:electron": "node scripts/electron-pack.mjs all",
    "pack:electron:node": "node scripts/electron-pack.mjs node",
    "pack:electron:sqlite": "node scripts/electron-pack.mjs sqlite",
    "pack:electron:only": "node scripts/electron-pack.mjs pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherry-xw/cheryClaw.git"
  },
  "keywords": [
    "sp"
  ],
  "author": "chery",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cherry-xw/cheryClaw/issues"
  },
  "homepage": "https://github.com/cherry-xw/cheryClaw#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.7",
    "chery-fetch": "^1.0.13",
    "concurrently": "^10.0.3",
    "eslint": "^10.2.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-native-modules": "^2.2.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.9.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@swc/wasm": "^1.15.40",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.10.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1",
    "motion-v": "^2.3.0",
    "nodemon": "^3.1.14",
    "ollama": "^0.6.3",
    "openai": "^6.35.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
