[Unit]
Description=CheryNyxus local manager
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.cherynyxus
ExecStart=/usr/bin/node %h/.cherynyxus/manager/dist/index.js
Environment=CHERY_DIR=%h/.cherynyxus
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
