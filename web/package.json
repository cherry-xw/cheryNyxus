{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "ELECTRON_ENABLED=false vite",
    "dev:electron": "bash scripts/electron-dev.sh",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "rebuild": "electron-builder install-app-deps",
    "type-check": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "element-plus": "^2.8.0",
    "motion-v": "^2.3.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.0",
    "less": "^4.6.7",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^2.2.0"
  }
}
