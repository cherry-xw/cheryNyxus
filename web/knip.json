{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/main.ts", "electron/main.ts", "electron/preload.ts"],
  "project": ["src/**/*.{ts,vue}", "electron/**/*.ts"],
  "ignore": ["dist/**", "dist-electron/**", "node_modules/**", "out/**"],
  "ignoreBinaries": ["electron", "cross-env", "vue-tsc"]
}
