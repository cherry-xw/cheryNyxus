{
  "extends": "../backend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@/*": ["apps/backend/src/*"],
      "@test/*": ["apps/backend/test/*"],
      "@chery/protocol": ["packages/protocol/src/index.ts"],
      "@chery/protocol/*": ["packages/protocol/src/*"],
      "@chery/manager/*": ["apps/manager/src/*"]
    }
  },
  "include": ["src/**/*.ts", "ui/usePlugins.ts", "../../packages/manager-ui/src/**/*.ts"],
  "exclude": ["../../node_modules", "../../dist", "../web"]
}
